@inherits LayoutComponentBase
@implements IDisposable
@inject IdentitySessionState Session
@inject ShellPresentationState Presentation
@inject Microsoft.JSInterop.IJSRuntime JavaScript
@inject NavigationManager Navigation

<div class="workspace-shell"
     data-theme="@Presentation.ThemeToken"
     data-density="@Presentation.DensityToken">
    <a class="skip-link"
       href="#main-content"
       @onclick="FocusMainAsync"
       @onclick:preventDefault>
        Skip to content
    </a>

    <header class="shell-header">
        <a class="shell-brand" href="/home" aria-label="Dispatcher home">
            <span class="shell-brand__mark" aria-hidden="true">
                <span></span><span></span><span></span>
            </span>
            <span class="shell-brand__text">
                <strong>Dispatcher</strong>
                <small>Operations workspace</small>
            </span>
        </a>

        <div class="shell-header__search">
            <WorkspaceSearchBox />
        </div>

        <div class="shell-header__actions">
            <ShellPreferenceControls />
            @if (Session.IsAuthenticated)
            {
                <NavLink class="session-link" href="/my-work">
                    <span>My Work</span>
                </NavLink>
            }
            <NavLink class="session-link" href="@SessionRoute">
                <span class="session-link__indicator"
                      data-active="@Session.IsAuthenticated"
                      aria-hidden="true"></span>
                <span>@(Session.IsAuthenticated ? "Session" : "Sign in")</span>
            </NavLink>
        </div>
    </header>

    <aside class="shell-navigation">
        <div class="shell-panel-heading">
            <span class="shell-panel-heading__eyebrow">Navigation</span>
            <h2>Operations</h2>
        </div>
        <WorkspaceNavigation />
    </aside>

    <main id="main-content"
          class="shell-main"
          tabindex="-1">
        <div class="shell-content">
            @Body
        </div>
    </main>

    <WorkspaceContextPanel />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.Changed +=
            HandlePresentationChanged;
        Presentation.Changed +=
            HandlePresentationChanged;
        await Presentation
            .InitializeAsync(JavaScript);
    }

    public void Dispose()
    {
        Session.Changed -=
            HandlePresentationChanged;
        Presentation.Changed -=
            HandlePresentationChanged;
    }

    private string SessionRoute
    {
        get
        {
            var relative =
                Navigation.ToBaseRelativePath(
                    Navigation.Uri);
            var returnUrl =
                ReturnUrlPolicy.Normalize(
                    $"/{relative}");
            return
                $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
        }
    }

    private void HandlePresentationChanged() =>
        _ = InvokeAsync(StateHasChanged);

    private async Task FocusMainAsync()
    {
        await JavaScript.InvokeAsync<bool>(
            "dispatcherUi.focusElement",
            ["main-content"]);
    }
}
