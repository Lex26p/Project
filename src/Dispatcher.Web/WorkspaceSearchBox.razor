@inject NavigationManager Navigation

<form class="workspace-search"
      role="search"
      @onsubmit="Submit"
      @onsubmit:preventDefault>
    <label class="workspace-search__field">
        <span class="workspace-search__icon" aria-hidden="true">⌕</span>
        <span class="visually-hidden">Global search</span>
        <input @bind="query"
               aria-label="Global search"
               autocomplete="off"
               placeholder="Search workspace" />
        <kbd aria-hidden="true">Enter</kbd>
    </label>
</form>

@code {
    private string query = string.Empty;

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        Navigation.NavigateTo(
            $"/search?q={Uri.EscapeDataString(query.Trim())}");
    }
}
