@inherits LayoutComponentBase
@implements IDisposable
@inject ShellPresentationState Presentation
@inject Microsoft.JSInterop.IJSRuntime JavaScript

<div class="kiosk-shell"
     data-theme="@Presentation.ThemeToken"
     data-density="@Presentation.DensityToken">
    <header class="kiosk-header">
        <div class="shell-brand shell-brand--kiosk">
            <span class="shell-brand__mark" aria-hidden="true">
                <span></span><span></span><span></span>
            </span>
            <span class="shell-brand__text">
                <strong>Dispatcher</strong>
                <small>Assigned terminal</small>
            </span>
        </div>
        <UiBadge Text="Read-only display"
                 Category="@UiBadgeCategory.State"
                 Tone="@UiBadgeTone.Information" />
    </header>

    <main class="kiosk-main"
          aria-label="Assigned terminal content">
        @Body
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Presentation.Changed +=
            HandlePresentationChanged;
        await Presentation
            .InitializeAsync(JavaScript);
    }

    public void Dispose() =>
        Presentation.Changed -=
            HandlePresentationChanged;

    private void HandlePresentationChanged() =>
        _ = InvokeAsync(StateHasChanged);
}
