@page "/current"
@inject IdentitySessionState Session

<PageTitle>Current values</PageTitle>

<GuardedContent Route="/current">
    @if (Session.Bootstrap?.DefaultScopeId is Guid scopeId)
    {
        <CurrentValueWidget ScopeId="scopeId" />
    }
    else
    {
        <p>No accessible runtime scope is available.</p>
    }
</GuardedContent>
