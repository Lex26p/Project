@inject ShellPresentationState Presentation
@inject Microsoft.JSInterop.IJSRuntime JavaScript

<div class="shell-preference-controls"
     role="group"
     aria-label="Appearance"
     aria-busy="@(!Presentation.IsInitialized)">
    <button class="shell-control"
            type="button"
            aria-label="Switch color theme"
            aria-pressed="@(Presentation.Theme == ShellTheme.Dark)"
            disabled="@(!Presentation.IsInitialized)"
            @onclick="ToggleThemeAsync">
        <span aria-hidden="true">
            @(Presentation.Theme == ShellTheme.Dark ? "☾" : "☀")
        </span>
        <span>@Presentation.ThemeLabel</span>
    </button>
    <button class="shell-control"
            type="button"
            aria-label="Switch interface density"
            aria-pressed="@(Presentation.Density == ShellDensity.Compact)"
            disabled="@(!Presentation.IsInitialized)"
            @onclick="ToggleDensityAsync">
        <span aria-hidden="true">≡</span>
        <span>@Presentation.DensityLabel</span>
    </button>
</div>

@code {
    protected override Task OnInitializedAsync() =>
        Presentation.InitializeAsync(
            JavaScript);

    private Task ToggleThemeAsync() =>
        Presentation.ToggleThemeAsync();

    private Task ToggleDensityAsync() =>
        Presentation.ToggleDensityAsync();
}
