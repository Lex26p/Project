@implements IDisposable
@inject WorkspaceApiClient Api
@inject IdentitySessionState Session
@inject NavigationManager Navigation

@if (transportOffline)
{
    <UiStatePanel Kind="@UiStateKind.Offline"
                  Title="Server unavailable"
                  Message="This route cannot be authorized while the server is offline."
                  ActionLabel="Retry"
                  OnAction="@ReloadAsync" />
}
else if (state.Access is null)
{
    <UiStatePanel Kind="@UiStateKind.Loading"
                  Title="Checking access"
                  Message="Validating the current session and route capabilities." />
}
else if (state.Access == RouteAccess.SessionExpired)
{
    <UiStatePanel Kind="@UiStateKind.SessionExpired"
                  Title="Session expired"
                  Message="Sign in again before continuing with this workspace."
                  ActionLabel="Sign in"
                  OnAction="@OpenLogin" />
}
else if (state.Access == RouteAccess.Unavailable)
{
    <UiStatePanel Kind="@UiStateKind.Error"
                  Title="Authorization unavailable"
                  Message="The server could not validate access to this route."
                  ActionLabel="Retry"
                  OnAction="@ReloadAsync" />
}
else if (state.Access == RouteAccess.Denied)
{
    <UiStatePanel Kind="@UiStateKind.Forbidden"
                  Title="Access denied"
                  Message="The current session does not have the capability required by this route." />
}
else
{
    @ChildContent
}

@code {
    private readonly WorkspaceRouteGuardState state = new();
    private CancellationTokenSource? navigationCancellation;
    private bool transportOffline;

    [Parameter, EditorRequired]
    public string Route { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    protected override Task OnParametersSetAsync() =>
        ReloadAsync();

    private async Task ReloadAsync()
    {
        var requestCancellation =
            new CancellationTokenSource();
        var previousCancellation =
            navigationCancellation;
        navigationCancellation =
            requestCancellation;
        previousCancellation?.Cancel();

        var generation = state.BeginNavigation(Route);
        transportOffline = false;
        try
        {
            var access =
                await Api.CheckAccessAsync(
                    Route,
                    requestCancellation.Token);
            if (state.CompleteNavigation(
                    generation,
                    access) &&
                access ==
                    RouteAccess.SessionExpired)
            {
                Session.Invalidate();
            }
        }
        catch (OperationCanceledException)
            when (requestCancellation
                .IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            if (state.IsCurrent(generation))
            {
                transportOffline = true;
            }
        }
        finally
        {
            if (ReferenceEquals(
                    navigationCancellation,
                    requestCancellation))
            {
                navigationCancellation = null;
            }

            requestCancellation.Dispose();
        }
    }

    public void Dispose()
    {
        var cancellation =
            navigationCancellation;
        navigationCancellation = null;
        cancellation?.Cancel();
    }

    private void OpenLogin()
    {
        var relative =
            Navigation.ToBaseRelativePath(
                Navigation.Uri);
        var returnUrl =
            ReturnUrlPolicy.Normalize(
                $"/{relative}");
        Navigation.NavigateTo(
            $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
    }
}
